---
import type { Recommendation } from '../lib/recommendations';
import { sourceById, topicLabel } from '../lib/sources';
import SourceMark from './SourceMark.astro';
import Icon from './Icon.astro';
interface Props { items: Recommendation[] }
const { items } = Astro.props;
---
<section class="recommendations" aria-labelledby="recommendations-heading">
  <div class="recommendation-heading"><div><p class="eyebrow">DÀNH RIÊNG MỘT CHÚT THỜI GIAN</p><h2 id="recommendations-heading">Gợi ý cho bạn<span class="heading-dot">.</span></h2></div><Icon name="globe" size={22}/></div>
  <p class="recommendation-description">Bài chưa đọc, chọn theo chủ đề bạn đã lưu hoặc đọc. Thêm một góc nhìn từ nguồn khác.</p>
  <div class="recommendation-grid">
    {items.map(({ article, reason }) => {
      const source = sourceById(article.sourceId)!;
      return <article class="recommendation-card">
        <span class="publisher"><SourceMark source={source} small/>{source.name}</span>
        <h3><a href={`/bai-viet/${article.id}`} lang="en">{article.title}</a></h3>
        <div class="recommendation-meta"><span>{topicLabel(article.topic)}</span><span>{article.contentStatus === 'unavailable' ? 'Bài gốc' : `${article.readingMinutes} phút đọc`}</span></div>
        <p class="recommendation-reason"><Icon name="arrow" size={14}/>{reason}</p>
      </article>;
    })}
  </div>
</section>
<style>
  .recommendations { margin:0 0 32px; padding:24px; border:1px solid var(--line); border-radius:8px; background:var(--canvas); }
  .recommendation-heading { display:flex; justify-content:space-between; align-items:center; gap:16px; color:var(--green); }
  .eyebrow { font-size:9px; letter-spacing:1.2px; margin-bottom:8px; }
  h2 { font-size:24px; line-height:1.4; font-weight:600; letter-spacing:-.7px; margin:0; }
  .recommendation-description { font-size:12px; line-height:1.8; color:var(--muted); margin:10px 0 20px; max-width:540px; }
  .recommendation-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }
  .recommendation-card { display:flex; flex-direction:column; min-width:0; }
  .recommendation-card+.recommendation-card { border-left:1px solid var(--line); padding-left:20px; }
  .publisher { font-size:11px; line-height:1.6; }
  h3 { font-size:16px; font-weight:600; line-height:1.6; letter-spacing:-.2px; margin:12px 0; overflow-wrap:anywhere; }
  h3 a { transition:color var(--duration-quick) var(--ease-out); }
  h3 a:hover { color:var(--accent); }
  .recommendation-meta { display:flex; flex-wrap:wrap; gap:4px 10px; margin-top:auto; color:var(--muted); font-size:10px; line-height:1.8; }
  .recommendation-reason { display:flex; align-items:flex-start; gap:6px; font-size:11px; line-height:1.7; margin:12px 0 0; color:var(--green); }
  .recommendation-reason svg { margin-top:3px; }
  @media(max-width:700px) {
    .recommendations { padding:20px; margin-bottom:26px; }
    .recommendation-grid { grid-template-columns:1fr; gap:18px; }
    .recommendation-card+.recommendation-card { border-left:0; padding-left:0; padding-top:18px; border-top:1px solid var(--line); }
    h3 { font-size:17px; margin:10px 0; }
    .recommendation-meta { font-size:11px; }
    .recommendation-description { font-size:13px; }
  }
  @media(prefers-reduced-motion:reduce) { h3 a { transition:none; } }
</style>
