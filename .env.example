# Local development only. Copy to .env; use matching credentials in DATABASE_URL.
# The prepared local .env uses a generated password instead of this example value.
POSTGRES_DB=radar_dev
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_dev_only_change_me
DATABASE_URL=postgresql://radar:radar_dev_only_change_me@127.0.0.1:5434/radar_dev

# No provider calls are made by the database setup.
TRANSLATION_PROVIDER=disabled
GEMINI_API_KEY=
